# ShellOS kernel config fragment
#
# Merged on top of Debian's 6.18 amd64 config (debian-6.18.15-amd64.config)
# by kernel/build.sh. Every line here is verified after `olddefconfig`;
# the build fails if Kconfig silently drops one. Rationale for each block
# lives in docs/KERNEL.md.

CONFIG_LOCALVERSION="-shellos"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Toolchain: Clang ThinLTO + AutoFDO + Propeller ------------------------
# AUTOFDO/PROPELLER must be on even without a profile: they add the
# -fdebug-info-for-profiling / basic-block-address metadata that the
# profiling step (shell-kernel-profile) needs to map samples back.
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG_THIN=y
CONFIG_AUTOFDO_CLANG=y
CONFIG_PROPELLER_CLANG=y
# Rust-for-Linux needs a rustc/bindgen pinned to the clang version; nothing
# on an Alder Lake desktop needs it.
# CONFIG_RUST is not set

# --- CPU scheduler ---------------------------------------------------------
# EEVDF + BORE burst-aware weighting, POC fast idle-CPU selector, and
# sched_ext so BPF schedulers (scx_lavd) can be swapped in at runtime.
CONFIG_SCHED_BORE=y
CONFIG_SCHED_POC_SELECTOR=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_MC_PRIO=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=1000
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_LAZY is not set
CONFIG_PREEMPT_DYNAMIC=y
# Tickless only when idle; NO_HZ_FULL adds syscall-entry overhead on every
# CPU for a feature only isolated-core workloads use.
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
# Single-socket desktop: shrink per-CPU arrays, drop NUMA balancing faults.
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=64
# CONFIG_NUMA_BALANCING is not set

# --- Idle & frequency (Intel hybrid) ---------------------------------------
CONFIG_CPU_IDLE_GOV_NAP=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_HFI_THERMAL=y

# --- Memory ----------------------------------------------------------------
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# zram: lz4 on the hot path, zstd recompression of idle pages (multi-comp).
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_TRACK_ENTRY_ACTIME=y
CONFIG_PSI=y

# --- Block I/O -------------------------------------------------------------
# Built in so the udev rules can pick per-device schedulers at first probe.
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# --- Network ---------------------------------------------------------------
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_FQ_CODEL is not set
CONFIG_DEFAULT_NET_SCH="fq"

# --- Modules & keys --------------------------------------------------------
# CONFIG_MODULE_COMPRESS_XZ is not set
CONFIG_MODULE_COMPRESS_ZSTD=y
# Debian points this at its own cert bundle, which we don't have.
CONFIG_SYSTEM_TRUSTED_KEYS=""

# --- Debug info (needed to map AutoFDO/Propeller samples) ------------------
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
