#!/usr/bin/env bash
# Run ShellOS in a QEMU/KVM virtual machine (UEFI, like real hardware).
#
#   vm/shellos-vm live    [ISO]  try the live ISO (no disk attached)
#   vm/shellos-vm install [ISO]  live ISO + the VM's disk: run "Install ShellOS"
#   vm/shellos-vm boot           boot the installed disk (Limine menu, snapshots)
#   vm/shellos-vm smoke   [ISO]  headless boot test over serial; exit 0 = healthy
#   vm/shellos-vm reset          delete the VM's disk and UEFI variables
#
# ISO defaults to the newest out/iso/*.iso. Settings (environment):
#   VM_DIR        where the disk and UEFI vars live (~/.local/share/shellos-vm)
#   VM_RAM        memory (8G)            VM_CPUS  vCPUs (4)
#   VM_DISK_SIZE  disk for installs (40G)
#   VM_DISPLAY    gtk | sdl | none (gtk)
#   VM_GL         on = virtio-gpu with host OpenGL (smoother COSMIC; needs
#                 working host GL), off = plain virtio-vga (default)
#   VM_KVM        auto (default) | off (pure emulation, slow)
#   VM_AUDIO      none (default) | pa | pipewire
#
# Needs: qemu-system-x86_64, OVMF (edk2) firmware; KVM for usable speed.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$HERE")"
VM_DIR="${VM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/shellos-vm}"
VM_RAM="${VM_RAM:-8G}"
VM_CPUS="${VM_CPUS:-4}"
VM_DISK_SIZE="${VM_DISK_SIZE:-40G}"
VM_DISPLAY="${VM_DISPLAY:-gtk}"
VM_GL="${VM_GL:-off}"
DISK="$VM_DIR/disk.qcow2"
VARS="$VM_DIR/OVMF_VARS.fd"

die() { printf 'shellos-vm: %s\n' "$*" >&2; exit 1; }
note() { printf 'shellos-vm: %s\n' "$*" >&2; }

# UEFI firmware: code + a writable copy of the variable store (boot entries
# created by the installer live there, just like NVRAM on real hardware).
find_ovmf() {
	local pair code vars
	for pair in \
		/usr/share/OVMF/OVMF_CODE_4M.fd:/usr/share/OVMF/OVMF_VARS_4M.fd \
		/usr/share/OVMF/OVMF_CODE.fd:/usr/share/OVMF/OVMF_VARS.fd \
		/usr/share/edk2/x64/OVMF_CODE.4m.fd:/usr/share/edk2/x64/OVMF_VARS.4m.fd \
		/usr/share/edk2/ovmf/OVMF_CODE.fd:/usr/share/edk2/ovmf/OVMF_VARS.fd \
		/usr/share/qemu/edk2-x86_64-code.fd:/usr/share/qemu/edk2-i386-vars.fd; do
		code="${pair%%:*}" vars="${pair##*:}"
		if [[ -f $code && -f $vars ]]; then
			OVMF_CODE="$code" OVMF_VARS_TEMPLATE="$vars"
			return
		fi
	done
	die "no OVMF/edk2 UEFI firmware found (Debian/Ubuntu: apt install ovmf; Fedora: edk2-ovmf; Arch: edk2-ovmf)"
}

newest_iso() {
	local iso
	iso="$(ls -t "$REPO"/out/iso/*.iso 2>/dev/null | head -1 || true)"
	[[ -n $iso ]] || die "no ISO given and none in out/iso/ (download one from the repo's Releases)"
	printf '%s' "$iso"
}

# The kernel is built with -march=alderlake. Under KVM the guest sees the
# host CPU, so the host must have the integer extensions that implies.
check_cpu() {
	local f missing=()
	for f in bmi1 bmi2 adx movbe abm popcnt; do
		grep -qw "$f" /proc/cpuinfo || missing+=("$f")
	done
	if (( ${#missing[@]} )); then
		note "warning: host CPU lacks ${missing[*]}; the ShellOS kernel (-march=alderlake)"
		note "         may crash under KVM. Set VM_KVM=off to emulate a capable CPU instead."
	fi
}

accel_args() {
	if [[ ${VM_KVM:-auto} != off && -w /dev/kvm ]]; then
		check_cpu
		ACCEL=(-accel kvm -cpu host)
	else
		[[ ${VM_KVM:-auto} == off ]] || note "no writable /dev/kvm: emulating (very slow). Add yourself to the kvm group."
		ACCEL=(-accel tcg -cpu max)
	fi
}

display_args() {
	DISPLAY_ARGS=()
	case "$VM_DISPLAY" in
		none) DISPLAY_ARGS=(-display none -vga none -device virtio-vga) ;;
		*)
			if [[ $VM_GL == on ]]; then
				DISPLAY_ARGS=(-device virtio-vga-gl -display "$VM_DISPLAY,gl=on")
			else
				DISPLAY_ARGS=(-vga none -device virtio-vga -display "$VM_DISPLAY")
			fi
			;;
	esac
}

run_qemu() { # extra args...
	find_ovmf
	mkdir -p "$VM_DIR"
	[[ -f $VARS ]] || cp "$OVMF_VARS_TEMPLATE" "$VARS"
	accel_args
	display_args
	exec qemu-system-x86_64 \
		-name ShellOS -machine q35 "${ACCEL[@]}" -smp "$VM_CPUS" -m "$VM_RAM" \
		-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
		-drive if=pflash,format=raw,file="$VARS" \
		"${DISPLAY_ARGS[@]}" \
		-device qemu-xhci -device usb-tablet -device usb-kbd \
		-nic user,model=virtio-net-pci \
		-device virtio-rng-pci \
		-device virtio-serial-pci \
		-chardev qemu-vdagent,id=vdagent,name=vdagent,clipboard=on \
		-device virtserialport,chardev=vdagent,name=com.redhat.spice.0 \
		-audiodev "${VM_AUDIO:-none},id=snd" -device intel-hda -device hda-duplex,audiodev=snd \
		"$@"
}

disk_args() {
	DISK_ARGS=(-drive "if=none,id=disk0,format=qcow2,file=$DISK,discard=unmap"
		-device "nvme,drive=disk0,serial=shellos0")
}

cmd="${1:-}"
shift || true
case "$cmd" in
	live)
		iso="${1:-$(newest_iso)}"
		run_qemu -cdrom "$iso" -boot d
		;;
	install)
		iso="${1:-$(newest_iso)}"
		mkdir -p "$VM_DIR"
		[[ -f $DISK ]] || qemu-img create -q -f qcow2 "$DISK" "$VM_DISK_SIZE"
		disk_args
		note "disk: $DISK. After installing, shut down and run: vm/shellos-vm boot"
		run_qemu "${DISK_ARGS[@]}" -cdrom "$iso" -boot d
		;;
	boot)
		[[ -f $DISK ]] || die "no installed disk yet; run: vm/shellos-vm install"
		disk_args
		run_qemu "${DISK_ARGS[@]}"
		;;
	smoke)
		exec python3 "$HERE/smoke.py" "${1:-$(newest_iso)}"
		;;
	reset)
		rm -f "$DISK" "$VARS"
		note "removed $DISK and $VARS"
		;;
	*)
		sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'
		exit 2
		;;
esac
