// ShellOS boot splash: the spiral logo breathing on the wallpaper colour.
Window.SetBackgroundTopColor(0.043, 0.078, 0.086);
Window.SetBackgroundBottomColor(0.020, 0.031, 0.035);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

t = 0;
fun refresh_callback() {
	t++;
	logo.sprite.SetOpacity(0.55 + 0.45 * Math.Sin(t / 18));
}
Plymouth.SetRefreshFunction(refresh_callback);

// Password prompt (e.g. if you add disk encryption later).
prompt.sprite = Sprite();
bullets.sprite = Sprite();
fun display_password_callback(text, count) {
	prompt.sprite.SetImage(Image.Text(text, 0.90, 0.96, 0.95));
	prompt.sprite.SetPosition(Window.GetWidth() / 2 - prompt.sprite.GetImage().GetWidth() / 2,
		Window.GetHeight() * 0.72, 1);
	stars = "";
	for (i = 0; i < count; i++) stars += "•";
	bullets.sprite.SetImage(Image.Text(stars, 0.18, 0.77, 0.71));
	bullets.sprite.SetPosition(Window.GetWidth() / 2 - bullets.sprite.GetImage().GetWidth() / 2,
		Window.GetHeight() * 0.72 + 30, 1);
}
fun display_normal_callback() {
	prompt.sprite.SetOpacity(0);
	bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
