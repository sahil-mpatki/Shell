# ShellOS notifications (dunst, X11 window managers).
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (16, 48)
    width = 360
    notification_limit = 5
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#2EC4B6"
    corner_radius = 10
    separator_color = frame
    font = JetBrains Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 48
    background = "#0B1416F2"
    foreground = "#E6F4F2"
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    frame_color = "#FF6B6B"
    timeout = 0
