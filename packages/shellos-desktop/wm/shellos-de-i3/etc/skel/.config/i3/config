# ShellOS i3 configuration. Same core keys as ShellOS's Hyprland, bspwm and dwm:
#   Super+Return terminal      Super+D apps          Super+Q close
#   Super+1..9 workspace       Super+Shift+1..9 move  Super+F fullscreen
#   Super+Space float          Super+H/J/K/L focus    Super+Shift+H/J/K/L move
#   Super+Escape lock          Super+Shift+E exit     Print screenshot
set $mod Mod4
set $term alacritty
set $menu rofi -show drun

font pango:JetBrains Mono 10
floating_modifier $mod
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4
smart_gaps on
focus_follows_mouse yes

#                       border   background text     indicator child_border
client.focused          #2EC4B6  #14201F    #E6F4F2  #2EC4B6   #2EC4B6
client.focused_inactive #1A4F4A  #0B1416    #6B8783  #1A4F4A   #1A4F4A
client.unfocused        #14201F  #0B1416    #6B8783  #14201F   #14201F
client.urgent           #FF6B6B  #FF6B6B    #0B1416  #FF6B6B   #FF6B6B

exec --no-startup-id /usr/lib/shellos/wm/x11-autostart

bindsym $mod+Return exec $term
bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+b exec firefox
bindsym $mod+q kill
bindsym $mod+Escape exec --no-startup-id shellos-lock
bindsym $mod+Shift+e exec --no-startup-id "i3-msg exit"
bindsym $mod+Shift+r restart
bindsym Print exec --no-startup-id "maim -s | xclip -selection clipboard -t image/png"
bindsym Shift+Print exec --no-startup-id "mkdir -p ~/Pictures && maim ~/Pictures/screenshot-$(date +%F-%H%M%S).png"

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+v split toggle
bindsym $mod+t layout toggle tabbed split
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 20 px
    bindsym j resize grow height 20 px
    bindsym k resize shrink height 20 px
    bindsym l resize grow width 20 px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9

bar {
    position top
    status_command i3status
    font pango:JetBrains Mono 10
    tray_output primary
    colors {
        background #0B1416
        statusline #E6F4F2
        separator  #1A4F4A
        #                  border  background text
        focused_workspace  #2EC4B6 #2EC4B6    #0B1416
        active_workspace   #1A4F4A #1A4F4A    #E6F4F2
        inactive_workspace #0B1416 #0B1416    #6B8783
        urgent_workspace   #FF6B6B #FF6B6B    #0B1416
    }
}
