# ShellOS i3 status bar.
general {
    colors = true
    color_good = "#2EC4B6"
    color_degraded = "#FFD166"
    color_bad = "#FF6B6B"
    interval = 5
    separator = "  "
}
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "volume master"
order += "tztime local"

wireless _first_ {
    format_up = "  %essid %quality"
    format_down = ""
}
ethernet _first_ {
    format_up = "  %ip"
    format_down = ""
}
battery all {
    format = "%status %percentage"
    format_down = ""
    status_chr = "⚡"
    status_bat = ""
    status_full = ""
}
cpu_usage {
    format = "cpu %usage"
}
memory {
    format = "mem %used"
    threshold_degraded = "10%"
}
volume master {
    format = "vol %volume"
    format_muted = "vol muted"
    device = "pulse"
}
tztime local {
    format = "%a %d %b  %H:%M"
}
