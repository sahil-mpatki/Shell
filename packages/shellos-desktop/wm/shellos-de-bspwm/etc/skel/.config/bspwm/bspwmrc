#!/bin/sh
# ShellOS bspwm configuration (keys live in ~/.config/sxhkd/sxhkdrc).
pgrep -u "$(id -u)" -x sxhkd >/dev/null || sxhkd &
/usr/lib/shellos/wm/x11-autostart
pkill -u "$(id -u)" -x polybar; polybar --config="$HOME/.config/polybar/config.ini" shellos &

bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width         2
bspc config window_gap           10
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true
bspc config normal_border_color  "#14201F"
bspc config active_border_color  "#1A4F4A"
bspc config focused_border_color "#2EC4B6"
bspc config presel_feedback_color "#1A7F76"

bspc rule -a Pavucontrol state=floating
bspc rule -a Nm-connection-editor state=floating
