#!/bin/sh
# Tell you when a new ShellOS release is published on GitHub.
#
#   shellos-update-check            check now (the timer runs this)
#   shellos-update-check --status   installed, latest and last-announced releases
#
# Runs from a systemd user timer (shellos-update-check.timer) in your desktop
# session. Each release is announced once; pre-releases are ignored. To turn
# it off: systemctl --user disable --now shellos-update-check.timer
set -eu

API=https://api.github.com/repos/sahil-mpatki/Shell/releases/latest
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/shellos"
SEEN="$STATE/last-release"
installed="$(cat /etc/shellos-release 2>/dev/null || true)"

# $2 is a newer version than $1 (v1.2.0 > v1.10.0 is handled by sort -V).
newer() {
	[ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

latest() {
	curl -fsSL --max-time 20 -H 'Accept: application/vnd.github+json' "$API" |
		python3 -c 'import json, sys; d = json.load(sys.stdin); print(d["tag_name"], d["html_url"])'
}

if [ "${1:-}" = --status ]; then
	echo "installed from: ${installed:-unknown}"
	echo "last announced: $(cat "$SEEN" 2>/dev/null || echo none)"
	echo "latest:         $(latest 2>/dev/null | cut -d' ' -f1 || echo unreachable)"
	exit 0
fi

# Offline or rate-limited: say nothing and try again next time.
info="$(latest 2>/dev/null)" || exit 0
tag="${info%% *}" url="${info#* }"

mkdir -p "$STATE"
base="$(cat "$SEEN" 2>/dev/null || echo "$installed")"
if [ -z "$base" ]; then
	# Nothing to compare against yet (e.g. installed from a weekly build):
	# start from the current release instead of announcing it.
	echo "$tag" > "$SEEN"
	exit 0
fi
newer "$base" "$tag" || exit 0

# notify-send fails without a notification server; then it's retried later.
action="$(timeout 3600 notify-send --app-name=ShellOS --icon=shellos --wait \
	--action=update="Update now" --action=notes="What's new" \
	"ShellOS $tag is available" \
	"Bring this system up to date with Update now, or later: sudo apt update && sudo apt full-upgrade")" \
	|| [ $? -eq 124 ]
echo "$tag" > "$SEEN"

case "$action" in
	update)
		exec alacritty --title "ShellOS update" -e sh -c \
			'sudo apt update && sudo apt full-upgrade; printf "\nDone. Press Enter to close. "; read -r _'
		;;
	notes)
		exec xdg-open "$url"
		;;
esac
