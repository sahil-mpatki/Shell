#!/bin/sh
# rootmnt is exported by initramfs-tools' init.
# shellcheck disable=SC2154
# Booting a Snapper snapshot (shellos.snapshot=N): the snapshot is
# read-only, so stack a tmpfs overlay on it. Changes vanish on reboot;
# `shellos-rollback N` makes the snapshot permanent.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

grep -q 'shellos\.snapshot=' /proc/cmdline || exit 0
# shellcheck source=/dev/null
. /scripts/functions

base=/run/shellos-snapshot
modprobe overlay || { log_failure_msg "overlay module missing; booting snapshot read-only"; exit 0; }
mkdir -p "$base/lower" "$base/rw"
mount -n -t tmpfs -o mode=0755 tmpfs "$base/rw"
mkdir -p "$base/rw/upper" "$base/rw/work"
mount -n --move "${rootmnt}" "$base/lower"
mount -n -t overlay \
	-o "lowerdir=$base/lower,upperdir=$base/rw/upper,workdir=$base/rw/work" \
	overlay "${rootmnt}"
log_success_msg "ShellOS: snapshot booted with a RAM overlay"
