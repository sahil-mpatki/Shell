#!/usr/bin/env bash
# shellos-rollback N: make Snapper snapshot N the root filesystem.
#
# Debian mounts / from the @ subvolume by name, so `snapper rollback` (which
# flips the btrfs default subvolume) doesn't apply. Instead:
#   snapshot N  -> writable copy under a temporary name
#   @           -> @rollback-<timestamp>   (kept until you delete it)
#   copy        -> @
# then the Limine menu is regenerated for the new @. Any failure along the
# way puts the original @ back, so the system always has a bootable @.
set -euo pipefail

die() { printf 'shellos-rollback: %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
[[ $# -eq 1 && $1 =~ ^[0-9]+$ ]] || die "usage: shellos-rollback SNAPSHOT_NUMBER"
N="$1"

# Works from the normal system and from a booted snapshot (overlay root).
DEV="$(blkid -U "$(sed -n 's/.*root=UUID=\([^ ]*\).*/\1/p' /proc/cmdline)")" \
	|| die "cannot find the root btrfs device"
TOP="$(mktemp -d /run/shellos-top.XXXXXX)"
trap 'umount "$TOP" 2>/dev/null; rmdir "$TOP"' EXIT
mount -o subvolid=5 "$DEV" "$TOP"

SNAP="$TOP/@snapshots/$N/snapshot"
[[ -d $SNAP ]] || die "snapshot $N not found"
[[ -d $TOP/@ ]] || die "no @ subvolume at the top level"

stamp="$(date +%Y%m%d-%H%M%S)"
NEW="@.rollback-new-$stamp"
OLD="@rollback-$stamp"
printf 'Roll back to snapshot %s? The current root is kept as %s. [y/N] ' "$N" "$OLD"
read -r ok
[[ $ok == [yY]* ]] || die "aborted"

# 1. Build the replacement first; nothing has changed if this fails.
btrfs subvolume snapshot "$SNAP" "$TOP/$NEW" \
	|| die "could not create a writable copy of snapshot $N; nothing changed"

# 2. Swap it in, undoing each step if the next one fails.
if ! mv "$TOP/@" "$TOP/$OLD"; then
	btrfs subvolume delete "$TOP/$NEW" >/dev/null || true
	die "could not move the current root aside; nothing changed"
fi
if ! mv "$TOP/$NEW" "$TOP/@"; then
	mv "$TOP/$OLD" "$TOP/@"
	btrfs subvolume delete "$TOP/$NEW" >/dev/null || true
	die "could not promote snapshot $N; the original root is back in place"
fi

# 3. The boot menu must point at the new @ and its kernels.
if ! shellos-limine-update; then
	mv "$TOP/@" "$TOP/$NEW"
	mv "$TOP/$OLD" "$TOP/@"
	shellos-limine-update || true
	die "boot menu update failed; rolled back to the original root (the snapshot copy is kept as $NEW)"
fi

echo "Snapshot $N is now @. The previous root is kept as $OLD;"
echo "delete it once you're happy: btrfs subvolume delete <top-level>/$OLD"
echo "Reboot to finish the rollback."
