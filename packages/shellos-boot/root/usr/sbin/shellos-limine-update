#!/usr/bin/env bash
# shellos-limine-update: sync kernels to the ESP and regenerate limine.conf.
#
# Limine reads FAT only, so every kernel + initrd is copied to
# $ESP/shellos/<version>/. The menu gets the newest kernel, a safe-mode
# entry, older kernels, and one entry per Snapper snapshot (booted
# read-only with a RAM overlay; see shellos-rollback to make one permanent).
#
# Called from kernel/initramfs hooks, the /.snapshots path unit, and by hand.
set -euo pipefail

# shellcheck source=/dev/null
[[ -r /etc/default/shellos-boot ]] && . /etc/default/shellos-boot
ESP="${SHELLOS_ESP:-/boot/efi}"
TIMEOUT="${SHELLOS_TIMEOUT:-3}"
CMDLINE="${SHELLOS_CMDLINE:-quiet splash}"
SAFE_CMDLINE="${SHELLOS_SAFE_CMDLINE:-}"
MAX_SNAPSHOTS="${SHELLOS_MAX_SNAPSHOTS:-10}"
SNAPSHOT_DIR="${SHELLOS_SNAPSHOT_DIR:-/.snapshots}"
ACCENT="2EC4B6"

log() { printf 'shellos-limine-update: %s\n' "$*"; }

if ! mountpoint -q "$ESP"; then
	log "$ESP is not mounted, skipping"
	exit 0
fi

# --- root filesystem ---------------------------------------------------------
# Inside a booted snapshot / is an overlay, so read the real root from the
# kernel command line's root= (which still names the btrfs filesystem).
ROOT_SRC="$(findmnt -no SOURCE / | sed 's/\[.*//')"
ROOT_FSTYPE="$(findmnt -no FSTYPE /)"
if [[ $ROOT_FSTYPE == overlay ]]; then
	ROOT_UUID="$(sed -n 's/.*root=UUID=\([^ ]*\).*/\1/p' /proc/cmdline)"
	ROOT_FSTYPE=btrfs
	ROOT_SUBVOL=@
else
	ROOT_UUID="$(blkid -s UUID -o value "$ROOT_SRC")"
	ROOT_SUBVOL="$(findmnt -no OPTIONS / | tr , '\n' | sed -n 's#^subvol=/\{0,1\}##p')"
fi
[[ -n $ROOT_UUID ]] || { log "cannot determine root UUID"; exit 1; }

root_args() { # $1 = subvolume (may be empty)
	local a="root=UUID=$ROOT_UUID"
	[[ $ROOT_FSTYPE == btrfs && -n $1 ]] && a+=" rootflags=subvol=$1"
	printf '%s' "$a"
}

# --- Limine EFI binary ---------------------------------------------------------
install_if_changed() { # src dst
	if ! cmp -s "$1" "$2" 2>/dev/null; then
		install -D -m644 "$1" "$2.new"
		mv "$2.new" "$2"
	fi
}
install_if_changed /usr/share/limine/BOOTX64.EFI "$ESP/EFI/shellos/BOOTX64.EFI"
# Removable-media fallback path, for firmware that forgets NVRAM entries.
install_if_changed /usr/share/limine/BOOTX64.EFI "$ESP/EFI/BOOT/BOOTX64.EFI"
[[ -f /usr/share/shellos/limine-wallpaper.png ]] &&
	install_if_changed /usr/share/shellos/limine-wallpaper.png "$ESP/shellos/wallpaper.png"

# --- kernels -------------------------------------------------------------------
# Installed = has modules in /lib/modules and a vmlinuz + initrd in /boot.
mapfile -t KERNELS < <(
	for k in /boot/vmlinuz-*; do
		v="${k#/boot/vmlinuz-}"
		[[ -f /boot/initrd.img-$v && -d /lib/modules/$v ]] && echo "$v"
	done | sort -rV
)
(( ${#KERNELS[@]} )) || { log "no kernels with initrd found in /boot"; exit 1; }

for v in "${KERNELS[@]}"; do
	install_if_changed "/boot/vmlinuz-$v" "$ESP/shellos/$v/vmlinuz"
	install_if_changed "/boot/initrd.img-$v" "$ESP/shellos/$v/initrd.img"
done

# Kernels whose files are on the ESP (may include ones only snapshots need).
on_esp() { [[ -f $ESP/shellos/$1/vmlinuz && -f $ESP/shellos/$1/initrd.img ]]; }

# --- snapshots -----------------------------------------------------------------
# Each snapshot boots the newest ESP kernel whose modules exist inside it.
declare -a SNAP_LINES=()
declare -A NEEDED=()
for v in "${KERNELS[@]}"; do NEEDED[$v]=1; done

if [[ -d $SNAPSHOT_DIR ]]; then
	mapfile -t SNAPS < <(find "$SNAPSHOT_DIR" -mindepth 1 -maxdepth 1 -regex '.*/[0-9]+' -printf '%f\n' | sort -rn)
	count=0
	for n in "${SNAPS[@]}"; do
		(( count < MAX_SNAPSHOTS )) || break
		info="$SNAPSHOT_DIR/$n/info.xml"
		root="$SNAPSHOT_DIR/$n/snapshot"
		[[ -f $info && -d $root/lib/modules ]] || continue
		kv=""
		while read -r m; do
			if on_esp "$m" || [[ -n ${NEEDED[$m]:-} ]]; then kv="$m"; break; fi
		done < <(find "$root/lib/modules" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -rV)
		[[ -n $kv ]] || continue
		NEEDED[$kv]=1
		date="$(sed -n 's:.*<date>\(.*\)</date>.*:\1:p' "$info")"
		desc="$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' "$info")"
		SNAP_LINES+=("$n|$kv|${date% *}|${desc:-snapshot}")
		count=$((count + 1))
	done
fi

# Drop ESP kernels nothing needs any more.
if [[ -d $ESP/shellos ]]; then
	for d in "$ESP"/shellos/*/; do
		v="$(basename "$d")"
		[[ -n ${NEEDED[$v]:-} ]] || { log "removing $v from ESP"; rm -rf "$d"; }
	done
fi

# --- limine.conf ---------------------------------------------------------------
CONF="$ESP/EFI/shellos/limine.conf"
TMP="$CONF.new"
newest="${KERNELS[0]}"
{
	echo "# Generated by shellos-limine-update. Edit /etc/default/shellos-boot instead."
	echo "timeout: $TIMEOUT"
	echo "interface_branding: ShellOS"
	echo "interface_branding_colour: $ACCENT"
	[[ -f $ESP/shellos/wallpaper.png ]] && echo "wallpaper: boot():/shellos/wallpaper.png"
	echo
	echo "/ShellOS"
	echo "    comment: $newest"
	echo "    protocol: linux"
	echo "    path: boot():/shellos/$newest/vmlinuz"
	echo "    module_path: boot():/shellos/$newest/initrd.img"
	echo "    cmdline: $(root_args "$ROOT_SUBVOL") rw $CMDLINE"
	echo
	echo "/ShellOS (safe mode)"
	echo "    comment: mitigations on, TEO idle governor, no sched_ext, verbose"
	echo "    protocol: linux"
	echo "    path: boot():/shellos/$newest/vmlinuz"
	echo "    module_path: boot():/shellos/$newest/initrd.img"
	echo "    cmdline: $(root_args "$ROOT_SUBVOL") rw $SAFE_CMDLINE"
	if (( ${#KERNELS[@]} > 1 )); then
		echo
		echo "/Older kernels"
		for v in "${KERNELS[@]:1}"; do
			echo "//$v"
			echo "    protocol: linux"
			echo "    path: boot():/shellos/$v/vmlinuz"
			echo "    module_path: boot():/shellos/$v/initrd.img"
			echo "    cmdline: $(root_args "$ROOT_SUBVOL") rw $CMDLINE"
		done
	fi
	if (( ${#SNAP_LINES[@]} )); then
		echo
		echo "/Snapshots"
		for line in "${SNAP_LINES[@]}"; do
			IFS='|' read -r n kv date desc <<<"$line"
			echo "//#$n  $date  $desc"
			echo "    comment: read-only with a RAM overlay; run shellos-rollback $n to keep it"
			echo "    protocol: linux"
			echo "    path: boot():/shellos/$kv/vmlinuz"
			echo "    module_path: boot():/shellos/$kv/initrd.img"
			echo "    cmdline: $(root_args "@snapshots/$n/snapshot") ro shellos.snapshot=$n systemd.mask=systemd-remount-fs.service $CMDLINE"
		done
	fi
} > "$TMP"
mv "$TMP" "$CONF"
# Firmware that boots the fallback path looks for the config next to it.
install_if_changed "$CONF" "$ESP/EFI/BOOT/limine.conf"

log "${#KERNELS[@]} kernel(s), ${#SNAP_LINES[@]} snapshot(s) -> $CONF"
