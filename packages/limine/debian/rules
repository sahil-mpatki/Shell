#!/usr/bin/make -f
# Limine's firmware stages are freestanding and set their own flags, so
# distro hardening is off. Keep PIE at the compiler default, though:
# "-pie" injects no-pie *compile* specs into CFLAGS_FOR_BUILD, but the
# host tools (e.g. limlzpack) compile and link in one step without
# LDFLAGS, so they'd link non-PIC objects as PIE and fail.
export DEB_BUILD_MAINT_OPTIONS = hardening=-all,+pie

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --enable-uefi-x86-64 --enable-bios --enable-bios-cd --enable-uefi-cd

# The EFI/BIOS images are not ELF objects for the host; leave them alone.
override_dh_strip:
	dh_strip --exclude=/usr/share/limine/
override_dh_dwz:
